# ============================================================
# Braxel Markets — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# ----------------------------------------------------------------
# Supabase (required for all builds)
# ----------------------------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ----------------------------------------------------------------
# Market Data (Twelve Data)
# ----------------------------------------------------------------
# Free tier: https://twelvedata.com/
# The build will use placeholder values if this is not set.
VITE_TWELVES_DATA_API_KEY=

# ----------------------------------------------------------------
# Gemini (AI Chatbot — optional)
# ----------------------------------------------------------------
# Get from: https://aistudio.google.com/
# Leave blank to use fallback responses.
VITE_GEMINI_API_KEY=

# ----------------------------------------------------------------
# Payment Gates (frontend build flags — do NOT set to "true"
# in development. Only set in production build environments.)
# ----------------------------------------------------------------
# Set to "true" in GitHub Actions / Vercel environment vars
# to enable the TEST payment UI.
# VITE_TEST_PAYMENT_MODE=true

# Set to "true" ONLY when live payments are approved.
# VITE_PAYMENTS_ENABLED=true

# ----------------------------------------------------------------
# Stripe TEST MODE (Supabase Edge Function Secrets — do NOT
# put these in .env files. Set them in:
#   Supabase Dashboard → Edge Functions → Secrets
# ----------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER_USD=price_...
# STRIPE_PRICE_PROFESSIONAL_USD=price_...
# STRIPE_PRICE_BUSINESS_USD=price_...
# STRIPE_PRICE_ENTERPRISE_USD=price_...
# STRIPE_SUCCESS_URL=https://your-domain.com/checkout/success

# ----------------------------------------------------------------
# Owner notifications — Resend (Supabase Edge Function Secrets)
# ----------------------------------------------------------------
# Every owner-facing notification goes through the single central module
# supabase/functions/_shared/email.ts (notifyOwner). Set these in
# Supabase Dashboard → Edge Functions → Secrets, NOT in a committed file.
#
# RESEND_API_KEY: create at https://resend.com/api-keys (starts with re_)
# EMAIL_FROM:     the sender shown on every outgoing email. Until a domain is
#                 verified in Resend this MUST stay "onboarding@resend.dev"
#                 (Resend's shared test sender), otherwise delivery is refused.
#                 Switching to a real domain later is an env change only:
#                   EMAIL_FROM=Braxel Markets <notifications@your-domain.com>
# EMAIL_TO:       your inbox — every owner notification is delivered here
# SUPPORT_INBOX_EMAIL: where the public "Institutional Support" form routes.
#                 Used ONLY by the server-side support-message function; the
#                 browser never sees it. Falls back to EMAIL_TO when unset.
# EMAIL_TEST_SECRET: guards the /email-test endpoint. Choose any long
#                 random string; required for the deployed test endpoint.
# RESEND_API_KEY=re_...
# EMAIL_FROM=onboarding@resend.dev
# EMAIL_TO=marketsbraxel@ouvidor.net
# SUPPORT_INBOX_EMAIL=marketsbraxel@ouvidor.net
# EMAIL_TEST_SECRET=change-me-to-a-long-random-string

# ----------------------------------------------------------------
# Internal (Supabase Edge Function Secrets)
# ----------------------------------------------------------------
# OPERATOR_EMAIL=operator@your-domain.com

# ----------------------------------------------------------------
# Exchange Rates (Supabase Edge Function Secrets — optional)
# ----------------------------------------------------------------
# EXCHANGERATE_API_KEY=
