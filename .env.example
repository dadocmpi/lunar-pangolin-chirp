# ============================================================
# Braxel Markets — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# ----------------------------------------------------------------
# Supabase (required for all builds)
# ----------------------------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ----------------------------------------------------------------
# Market Data (Twelve Data)
# ----------------------------------------------------------------
# Free tier: https://twelvedata.com/
# The build will use placeholder values if this is not set.
VITE_TWELVES_DATA_API_KEY=

# ----------------------------------------------------------------
# Gemini (AI Chatbot — optional)
# ----------------------------------------------------------------
# Get from: https://aistudio.google.com/
# Leave blank to use fallback responses.
VITE_GEMINI_API_KEY=

# ----------------------------------------------------------------
# Payments gate — SINGLE SOURCE OF TRUTH
# ----------------------------------------------------------------
# Frontend build flags (Vercel → Project Settings → Environment Variables).
# The client gate is ON when EITHER flag is "true":
#
#   TEST mode : VITE_TEST_PAYMENT_MODE=true
#   LIVE mode : VITE_PAYMENTS_ENABLED=true
#
# Leaving both unset (or "false") renders the localized
# "Payments are currently disabled" notice on /checkout and /checkout/success.
# Changing these requires a redeploy (Vite inlines them at build time).
# VITE_TEST_PAYMENT_MODE=true
# VITE_PAYMENTS_ENABLED=true

# Server gate (Supabase Dashboard → Edge Functions → Secrets). This is the
# REAL security boundary: every payment Edge Function re-checks it and fails
# closed (HTTP 503) when both are off. Keep it consistent with the frontend.
#   TEST mode : TEST_PAYMENT_MODE=true
#   LIVE mode : PAYMENTS_ENABLED=true
# TEST_PAYMENT_MODE=true
# PAYMENTS_ENABLED=true

# ----------------------------------------------------------------
# Wise bank account (Supabase Edge Function Secrets)
# ----------------------------------------------------------------
# Required in LIVE mode. wise-checkout fails closed (HTTP 503
# payment_destination_unconfigured) when these are missing, so a live payer
# is never shown the test placeholder bank. Not used in TEST mode.
# WISE_HOLDER_NAME=Braxel Markets Ltd
# WISE_BANK_NAME=Wise
# WISE_ACCOUNT_NUMBER=12345678      # or use WISE_IBAN
# WISE_IBAN=GB00 XXXX 0000 0000     # alternative to WISE_ACCOUNT_NUMBER
# WISE_ROUTING_NUMBER=000000        # optional, US/other rails
# WISE_SWIFT=TRWIGB2T               # optional

# ----------------------------------------------------------------
# Crypto deposit addresses (Supabase Edge Function Secrets)
# ----------------------------------------------------------------
# Required in LIVE mode for each network you want to accept. crypto-checkout
# fails closed (HTTP 503 payment_destination_unconfigured) for a network whose
# address is missing, so a live payer is never shown the test placeholder.
# Not used in TEST mode.
# CRYPTO_DESTINATION_BTC=bc1...
# CRYPTO_DESTINATION_TRC20=T...
# CRYPTO_DESTINATION_ETH=0x...
# CRYPTO_DESTINATION_BNB=0x...
# CRYPTO_DESTINATION_POLYGON=0x...
# CRYPTO_DESTINATION_SOL=...

# ----------------------------------------------------------------
# Stripe (Supabase Edge Function Secrets — do NOT put these in
# .env files. Set them in:
#   Supabase Dashboard → Edge Functions → Secrets
# ----------------------------------------------------------------
# TEST mode uses keys/price IDs from the Stripe sandbox (sk_test_… / price_…).
# LIVE mode uses the live equivalents (sk_live_… / price_…).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER_USD=price_...
# STRIPE_PRICE_PROFESSIONAL_USD=price_...
# STRIPE_PRICE_BUSINESS_USD=price_...
# STRIPE_PRICE_ENTERPRISE_USD=price_...
# STRIPE_SUCCESS_URL=https://your-domain.com/checkout/success
# STRIPE_CANCEL_URL=https://your-domain.com/pricing

# ----------------------------------------------------------------
# Wise / crypto (Supabase Edge Function Secrets)
# ----------------------------------------------------------------
# The current Wise and crypto flows return TEST placeholders and require
# manual admin confirmation. Real bank details / deposit addresses are a
# separate integration; configure them as Edge Function secrets only, never
# in the browser bundle.
# ADMIN_SECRET=...            # guards crypto-confirmation (manual admin path)
# TEST_CONFIRM_SECRET=...     # guards test-confirm-payment (test mode only)

# ----------------------------------------------------------------
# AI KYC — identity-document consistency check (Supabase Edge
# Function Secrets; service-side only, never in the browser bundle)
# ----------------------------------------------------------------
# When set, kyc-submit sends the ID front/back/selfie to a vision model that
# checks CONSISTENCY (name match, expiry, age, readable). It is advisory and
# fails CLOSED: no key, a provider error, malformed output or low confidence
# all route the submission to manual review. A clean, high-confidence pass may
# auto-approve. The decision is always written to public.kyc_ai_checks.
# Leave unset to keep 100% human review (the AI step is skipped).
# KYC_AI_API_KEY=...
# KYC_AI_MODEL=gemini-2.0-flash

# ----------------------------------------------------------------
# Owner notifications — Resend (Supabase Edge Function Secrets)
# ----------------------------------------------------------------
# Every owner-facing notification goes through the single central module
# supabase/functions/_shared/email.ts (notifyOwner). Set these in
# Supabase Dashboard → Edge Functions → Secrets, NOT in a committed file.
#
# RESEND_API_KEY: create at https://resend.com/api-keys (starts with re_)
# EMAIL_FROM:     the sender shown on every outgoing email. Until a domain is
#                 verified in Resend this MUST stay "onboarding@resend.dev"
#                 (Resend's shared test sender), otherwise delivery is refused.
#                 Switching to a real domain later is an env change only:
#                   EMAIL_FROM=Braxel Markets <notifications@your-domain.com>
# EMAIL_TO:       your inbox — every owner notification is delivered here
# SUPPORT_INBOX_EMAIL: where the public "Institutional Support" form routes.
#                 Used ONLY by the server-side support-message function; the
#                 browser never sees it. Falls back to EMAIL_TO when unset.
# EMAIL_TEST_SECRET: guards the /email-test endpoint. Choose any long
#                 random string; required for the deployed test endpoint.
# RESEND_API_KEY=re_...
# EMAIL_FROM=onboarding@resend.dev
# EMAIL_TO=marketsbraxel@ouvidor.net
# SUPPORT_INBOX_EMAIL=marketsbraxel@ouvidor.net
# EMAIL_TEST_SECRET=change-me-to-a-long-random-string

# ----------------------------------------------------------------
# Internal (Supabase Edge Function Secrets)
# ----------------------------------------------------------------
# OPERATOR_EMAIL=operator@your-domain.com

# ----------------------------------------------------------------
# Exchange Rates (Supabase Edge Function Secrets — optional)
# ----------------------------------------------------------------
# EXCHANGERATE_API_KEY=
